NODE_ENV=development
PORT=3001
CORS_ORIGIN=none
TRUST_PROXY=false

JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-64-caracteres
JWT_EXPIRES_IN=8h
JWT_ISSUER=beck-mobile-backend
JWT_AUDIENCE=beck-app

AZURE_AD_CLIENT_ID=id-de-la-aplicacion-en-microsoft-entra
AZURE_AD_TENANT_ID=id-del-tenant-de-microsoft-entra

DATABASE_URL=postgresql://usuario:password@host:5432/beck
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

CLOUDINARY_CLOUD_NAME=nombre_cloud
CLOUDINARY_API_KEY=api_key
CLOUDINARY_API_SECRET=api_secret
