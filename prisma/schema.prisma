model actividad_app {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id   String   @db.Uuid
  modulo       String   @db.VarChar(50)
  accion       String   @db.VarChar(100)
  entidad_tipo String?  @db.VarChar(50)
  entidad_id   String?  @db.Uuid
  descripcion  String   @db.VarChar(500)
  metodo       String   @db.VarChar(10)
  ruta         String   @db.VarChar(255)
  datos        Json?
  created_at   DateTime @default(now()) @db.Timestamp(6)
  usuarios     usuarios @relation(fields: [usuario_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([usuario_id, created_at(sort: Desc)], map: "actividad_app_usuario_created_at_idx")
  @@index([modulo])
  @@index([accion])
  @@index([entidad_id])
  @@index([created_at(sort: Desc)])
}

model usuarios_obras {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
