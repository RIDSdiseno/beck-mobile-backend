generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model cotizaciones {
  id                                             String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  obra_id                                        String?                 @db.Uuid
  estado                                         EstadoCotizacion        @default(BORRADOR)
  creado_por_id                                  String                  @db.Uuid
  created_at                                     DateTime                @default(now()) @db.Timestamp(6)
  updated_at                                     DateTime                @db.Timestamp(6)
  numero                                         String?                 @db.VarChar(50)
  descuento                                      Decimal                 @default(0) @db.Decimal(12, 2)
  subtotal                                       Decimal                 @db.Decimal(12, 2)
  total                                          Decimal                 @db.Decimal(12, 2)
  cliente_nombre                                 String                  @db.VarChar(255)
  observaciones                                  String?
  vigencia                                       DateTime                @db.Timestamp(6)
  impuesto                                       Decimal                 @default(0) @db.Decimal(12, 2)
  aplicaImpuesto                                 Boolean                 @default(true)
  funnel_beck_id                                 String?                 @db.Uuid
  cotizacion_base_id                             String?                 @db.Uuid
  es_actual                                      Boolean                 @default(true)
  version                                        Int                     @default(1)
  cliente_beck_id                                String?                 @db.Uuid
  contacto_beck_id                               String?                 @db.Uuid
  responsable_id                                 String?                 @db.Uuid
  clientes_beck                                  clientes_beck?          @relation(fields: [cliente_beck_id], references: [id])
  contactos_cliente_beck                         contactos_cliente_beck? @relation(fields: [contacto_beck_id], references: [id])
  cotizaciones                                   cotizaciones?           @relation("cotizacionesTocotizaciones", fields: [cotizacion_base_id], references: [id])
  other_cotizaciones                             cotizaciones[]          @relation("cotizacionesTocotizaciones")
  usuarios                                       usuarios                @relation(fields: [creado_por_id], references: [id])
  funnel_beck                                    funnel_beck?            @relation(fields: [funnel_beck_id], references: [id])
  obras                                          obras?                  @relation(fields: [obra_id], references: [id])
  usuarios_cotizaciones_responsable_idTousuarios usuarios?               @relation("cotizaciones_responsable_idTousuarios", fields: [responsable_id], references: [id])
  lineas_cotizacion                              lineas_cotizacion[]

  @@unique([numero, version])
  @@index([cliente_nombre])
  @@index([creado_por_id])
  @@index([estado])
  @@index([funnel_beck_id])
  @@index([obra_id])
  @@index([cotizacion_base_id])
  @@index([es_actual])
  @@index([numero])
  @@index([version])
  @@index([cliente_beck_id])
  @@index([contacto_beck_id])
  @@index([responsable_id])
}

