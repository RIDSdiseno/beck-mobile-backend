  clientes_beck                         clientes_beck?                @relation(fields: [cliente_beck_id], references: [id])
  contactos_cliente_beck                contactos_cliente_beck?       @relation(fields: [contacto_beck_id], references: [id])
  obras                                 obras?                        @relation(fields: [obra_id], references: [id])
  funnel_beck_archivos                  funnel_beck_archivos[]
  historial_etapas_beck                 historial_etapas_beck[]
  solicitudes_oficina_tecnica           solicitudes_oficina_tecnica[]

  @@index([comuna])
  @@index([empresa])
  @@index([estadoCierre])
  @@index([etapa])
  @@index([fecha_probable_cierre])
  @@index([region])
  @@index([vendedor])
  @@index([cliente_beck_id])
  @@index([contacto_beck_id])
  @@index([obra_id])
}

model indicadores_economicos {
  id         String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  tipo       TipoIndicadorEconomico @unique
  valor      Decimal                @db.Decimal(12, 4)
  fecha      DateTime               @db.Timestamp(6)
  created_at DateTime               @default(now()) @db.Timestamp(6)
  updated_at DateTime               @default(now()) @db.Timestamp(6)
}

model inventario {
  id                     String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo_producto        String                   @unique @db.VarChar(100)
  nombre                 String                   @db.VarChar(255)
  descripcion            String?
  stock_actual           Int                      @default(0)
  stock_minimo           Int                      @default(0)
  ubicacion              String?                  @db.VarChar(255)
  created_at             DateTime                 @default(now()) @db.Timestamp(6)
  updated_at             DateTime                 @default(now()) @db.Timestamp(6)
  movimientos_inventario movimientos_inventario[]

  @@index([codigo_producto])
  @@index([stock_actual])
}

model itemizados {
  id                       String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  codigo                   String                     @unique @db.VarChar(100)
  nombre                   String                     @db.VarChar(255)
  descripcion              String?
  precio_unitario          Decimal                    @default(0) @db.Decimal(12, 2)
  creado_por_id            String                     @db.Uuid
  created_at               DateTime                   @default(now()) @db.Timestamp(6)
  updated_at               DateTime                   @default(now()) @db.Timestamp(6)
  usuarios                 usuarios                   @relation(fields: [creado_por_id], references: [id])
  procesamiento_ingenieria procesamiento_ingenieria[]

  @@index([codigo])
  @@index([creado_por_id])
}

model lineas_cotizacion {
  id                  String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  cotizacion_id       String              @db.Uuid
  descripcion         String
  cantidad            Decimal             @db.Decimal(10, 3)
  precio_unitario     Decimal             @db.Decimal(12, 2)
  subtotal            Decimal             @db.Decimal(12, 2)
  created_at          DateTime            @default(now()) @db.Timestamp(6)
  updated_at          DateTime            @db.Timestamp(6)
  ganancia_pct        Decimal             @default(0) @db.Decimal(6, 2)
  notas_linea         String?
  orden               Int                 @default(0)
  tipo_linea          TipoLineaCotizacion @default(PRODUCTO)
  unidad              String?             @db.VarChar(50)
  producto_firemat_id Int?
  cotizaciones        cotizaciones        @relation(fields: [cotizacion_id], references: [id], onDelete: Cascade)

  @@index([cotizacion_id])
}

model movimientos_inventario {
  id               String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  producto_id      String         @db.Uuid
  tipo             TipoMovimiento
  cantidad         Int
  usuario_id       String         @db.Uuid
  codigo_escaneado String?        @db.VarChar(255)
  observaciones    String?
  created_at       DateTime       @default(now()) @db.Timestamp(6)
  inventario       inventario     @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  usuarios         usuarios       @relation(fields: [usuario_id], references: [id])

  @@index([created_at(sort: Desc)])
  @@index([producto_id])
  @@index([usuario_id])
}

model notificaciones {
  id            String           @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  usuario_id    String           @db.Uuid
  tipo          TipoNotificacion
  referencia_id String?          @db.Uuid
  mensaje       String
  leido         Boolean          @default(false)
  created_at    DateTime         @default(now()) @db.Timestamp(6)
  usuarios      usuarios         @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@index([created_at(sort: Desc)])
  @@index([leido])
  @@index([usuario_id])
}

model obras {
  id                                                   String                                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nombre                                               String                                @db.VarChar(255)
  codigo                                               String?                               @unique @db.VarChar(100)
  descripcion                                          String?
  estado                                               EstadoObra                            @default(activa)
  creado_por_id                                        String                                @db.Uuid
  created_at                                           DateTime                              @default(now()) @db.Timestamp(6)
  updated_at                                           DateTime                              @default(now()) @db.Timestamp(6)
  cliente                                              String?                               @db.VarChar(255)
  direccion                                            String?
  cliente_beck_id                                      String?                               @db.Uuid
  comuna                                               String?                               @db.VarChar(150)
  region                                               String?                               @db.VarChar(150)
  estado_preparacion_itemizado                         EstadoPreparacionItemizado            @default(PREPARACION)
  itemizado_finalizado_at                              DateTime?                             @db.Timestamp(6)
  itemizado_finalizado_por_id                          String?                               @db.Uuid
  asignaciones_inventario_beck                         asignaciones_inventario_beck[]
  configuracion_campos_registro                        configuracion_campos_registro[]
  configuracion_itemizado_opcion_obra                  configuracion_itemizado_opcion_obra[]
  cotizaciones                                         cotizaciones[]
  factor_accesibilidad_obra                            factor_accesibilidad_obra[]
  factor_aislacion_obra                                factor_aislacion_obra[]
  factor_holgura_tramos                                factor_holgura_tramos[]
  funnel_beck                                          funnel_beck[]
  hitos_obra                                           hitos_obra[]
  obra_tipos_registro                                  obra_tipos_registro[]
  clientes_beck                                        clientes_beck?                        @relation(fields: [cliente_beck_id], references: [id])
  usuarios                                             usuarios                              @relation(fields: [creado_por_id], references: [id])
  usuarios_obras_itemizado_finalizado_por_idTousuarios usuarios?                             @relation("obras_itemizado_finalizado_por_idTousuarios", fields: [itemizado_finalizado_por_id], references: [id])
  registros_terreno                                    registros_terreno[]
  trazabilidad_inventario_beck                         trazabilidad_inventario_beck[]
  usuarios_obras                                       usuarios_obras[]

  @@index([codigo])
  @@index([creado_por_id])
  @@index([estado])
  @@index([cliente_beck_id])
  @@index([estado_preparacion_itemizado])
  @@index([itemizado_finalizado_por_id])
}

model procesamiento_ingenieria {
  id                     String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  registro_terreno_id    String            @unique @db.Uuid
  usuario_id             String            @db.Uuid
  codigo                 String?           @db.VarChar(100)
  itemizado_id           String?           @db.Uuid
  total_sellos_calculado Decimal?          @db.Decimal(12, 2)
  notas                  String?
  procesado_at           DateTime          @default(now()) @db.Timestamp(6)
  itemizados             itemizados?       @relation(fields: [itemizado_id], references: [id])
  registros_terreno      registros_terreno @relation(fields: [registro_terreno_id], references: [id], onDelete: Cascade)
  usuarios               usuarios          @relation(fields: [usuario_id], references: [id])

  @@index([itemizado_id])
  @@index([registro_terreno_id])
  @@index([usuario_id])
}

model registros_terreno {
  id                                                                  String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  obra_id                                                             String                    @db.Uuid
  usuario_id                                                          String                    @db.Uuid
  fecha                                                               DateTime                  @db.Date
  dia_semana                                                          String                    @db.VarChar(20)
  descripcion_material                                                String                    @db.VarChar(500)
  modulo                                                              String                    @db.VarChar(100)
  piso                                                                String                    @db.VarChar(50)
  eje_numerico                                                        String                    @db.VarChar(50)
  eje_alfabetico                                                      String                    @db.VarChar(10)
  numero_sello                                                        String                    @db.VarChar(100)
  cantidad_sellos                                                     Int
  nombre_sellador                                                     String                    @db.VarChar(255)
  holgura                                                             Decimal                   @db.Decimal(3, 1)
  observaciones                                                       String?
  fotos_urls                                                          String[]
  created_at                                                          DateTime                  @default(now()) @db.Timestamp(6)
  updated_at                                                          DateTime                  @default(now()) @db.Timestamp(6)
  estado                                                              EstadoRegistroTerreno     @default(pendiente)
  metros_lineales                                                     Float?
  tipo_registro                                                       String                    @default("sello_cortafuego") @db.VarChar(50)
  devuelto_a_tecnico                                                  Boolean                   @default(false)
  codigo_beck                                                         String?
  itemizado_mandante_id                                               String?                   @db.Uuid
  itemizado_beck                                                      String?                   @db.VarChar(500)
  itemizado_mandante                                                  String?                   @db.VarChar(255)
  foto_url                                                            String?
  recinto                                                             String?                   @db.VarChar(100)
  factor_por_holguras                                                 Decimal?                  @db.Decimal(6, 2)
  accesibilidad                                                       Int?
  cantidad_sellos_con_factores                                        Decimal?                  @db.Decimal(12, 2)
  aislacion                                                           Decimal?                  @db.Decimal(6, 2)
  cantidad_sellos_aislacion                                           Decimal?                  @db.Decimal(12, 2)
  reparacion_tabique                                                  Decimal?                  @db.Decimal(6, 2)
  cantidad_final                                                      Decimal?                  @db.Decimal(12, 2)
  folio                                                               String?                   @db.VarChar(100)
  corregido_at                                                        DateTime?                 @db.Timestamp(6)
  fecha_rechazo                                                       DateTime?                 @db.Timestamp(6)
  motivo_rechazo                                                      String?
  rechazado_por_id                                                    String?                   @db.Uuid
  reenviado_revision_at                                               DateTime?                 @db.Timestamp(6)
  es_correccion                                                       Boolean                   @default(false)
  registro_origen_id                                                  String?                   @db.Uuid
  fecha_seleccion_inspeccion                                          DateTime?                 @db.Timestamp(6)
  seleccionado_inspeccion_por_id                                      String?                   @db.Uuid
  seleccionado_para_inspeccion                                        Boolean                   @default(false)
  validado_cliente                                                    Boolean                   @default(false)
  validado_cliente_at                                                 DateTime?                 @db.Timestamp(6)
  validado_cliente_por_id                                             String?                   @db.Uuid
  inspeccion_estado                                                   EstadoInspeccion          @default(no_enviado)
  inspeccion_revision_at                                              DateTime?                 @db.Timestamp(6)
  inspeccion_revision_estado                                          EstadoRevisionInspeccion  @default(pendiente)
  inspeccion_revision_por_id                                          String?                   @db.Uuid
  motivo_rechazo_inspeccion                                           String?
  firma_cliente_url                                                   String?
  pdf_firmado_url                                                     String?
  nombre_firmante_cliente                                             String?                   @db.VarChar(255)
  carga_completa                                                      Boolean                   @default(true)
  enviado_ingenieria_at                                               DateTime?                 @db.Timestamp(6)
  enviado_ingenieria_por_id                                           String?                   @db.Uuid
  dimensiones                                                         String?                   @db.VarChar(100)
  controles_inspeccion                                                controles_inspeccion[]
  fotos                                                               fotos_registro[]
  procesamiento_ingenieria                                            procesamiento_ingenieria?
  usuarios_registros_terreno_enviado_ingenieria_por_idTousuarios      usuarios?                 @relation("registros_terreno_enviado_ingenieria_por_idTousuarios", fields: [enviado_ingenieria_por_id], references: [id], onUpdate: NoAction)
  usuarios_registros_terreno_inspeccion_revision_por_idTousuarios     usuarios?                 @relation("registros_terreno_inspeccion_revision_por_idTousuarios", fields: [inspeccion_revision_por_id], references: [id])
  itemizados_mandante                                                 itemizados_mandante?      @relation(fields: [itemizado_mandante_id], references: [id])
  obras                                                               obras                     @relation(fields: [obra_id], references: [id], onDelete: Cascade)
  usuarios_registros_terreno_rechazado_por_idTousuarios               usuarios?                 @relation("registros_terreno_rechazado_por_idTousuarios", fields: [rechazado_por_id], references: [id])
  registros_terreno                                                   registros_terreno?        @relation("registros_terrenoToregistros_terreno", fields: [registro_origen_id], references: [id])
  other_registros_terreno                                             registros_terreno[]       @relation("registros_terrenoToregistros_terreno")
  usuarios_registros_terreno_seleccionado_inspeccion_por_idTousuarios usuarios?                 @relation("registros_terreno_seleccionado_inspeccion_por_idTousuarios", fields: [seleccionado_inspeccion_por_id], references: [id])
  usuarios                                                            usuarios                  @relation(fields: [usuario_id], references: [id])
  usuarios_registros_terreno_validado_cliente_por_idTousuarios        usuarios?                 @relation("registros_terreno_validado_cliente_por_idTousuarios", fields: [validado_cliente_por_id], references: [id])

  @@index([estado])
  @@index([devuelto_a_tecnico])
  @@index([fecha(sort: Desc)])
  @@index([obra_id])
  @@index([usuario_id])
  @@index([tipo_registro])
  @@index([itemizado_mandante_id])
  @@index([es_correccion])
  @@index([rechazado_por_id])
  @@index([enviado_ingenieria_por_id])
  @@index([enviado_ingenieria_at])
  @@index([registro_origen_id])
  @@index([seleccionado_inspeccion_por_id])
  @@index([seleccionado_para_inspeccion])
  @@index([inspeccion_estado])
  @@index([inspeccion_revision_estado])
  @@index([inspeccion_revision_por_id])
  @@index([validado_cliente])
  @@index([validado_cliente_por_id])
  @@index([carga_completa, created_at])
}

model fotos_registro {
  id                String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  registro_id       String            @db.Uuid
  url               String
  public_id         String            @db.VarChar(255)
  nombre_archivo    String?           @db.VarChar(255)
  formato           String?           @db.VarChar(50)
  bytes             Int?
  subido_por_id     String?           @db.Uuid
  created_at        DateTime          @default(now()) @db.Timestamp(6)
  registros_terreno registros_terreno @relation(fields: [registro_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fotos_registro_registro")
  usuarios          usuarios?         @relation(fields: [subido_por_id], references: [id], onUpdate: NoAction, map: "fk_fotos_registro_usuario")

  @@index([registro_id], map: "idx_fotos_registro_registro_id")
  @@index([subido_por_id], map: "idx_fotos_registro_subido_por_id")
}

model fotos_control_inspeccion {
  id                    String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  control_inspeccion_id String               @db.Uuid
  url                   String
  public_id             String               @db.VarChar(255)
  nombre_archivo        String?              @db.VarChar(255)
  formato               String?              @db.VarChar(50)
  bytes                 Int?
  subido_por_id         String?              @db.Uuid
  created_at            DateTime             @default(now()) @db.Timestamp(6)
  controles_inspeccion  controles_inspeccion @relation(fields: [control_inspeccion_id], references: [id], onDelete: Cascade, map: "fk_fotos_control_inspeccion_control")
  usuarios              usuarios?            @relation(fields: [subido_por_id], references: [id], map: "fk_fotos_control_inspeccion_usuario")

  @@index([control_inspeccion_id], map: "idx_fotos_control_inspeccion_control_id")
  @@index([subido_por_id], map: "idx_fotos_control_inspeccion_subido_por_id")
}

