  fecha_tipo_cambio                     DateTime?                     @db.Timestamp(6)
  uf_valor                              Decimal?                      @db.Decimal(12, 4)
  ajustes_solicitados                   String?
  cargo_contacto                        String?                       @db.VarChar(120)
  contrapropuestas                      String?
  correo_contacto                       String?                       @db.VarChar(255)
  documento_respaldo                    String?
  etapa_perdida                         String?                       @db.VarChar(100)
  fecha_primer_contacto                 DateTime?                     @db.Date
  fecha_proxima_accion                  DateTime?                     @db.Date
  fecha_reactivacion                    DateTime?                     @db.Date
  flujo_posterior                       String?
  motivo_postergacion                   String?
  necesidad_detectada                   String?
  nivel_interes                         String?                       @db.VarChar(50)
  nombre_contacto                       String?                       @db.VarChar(255)
  objeciones                            String?
  probabilidad_cierre                   Int?
  proxima_accion                        String?
  rut_empresa                           String?                       @db.VarChar(20)
  telefono_contacto                     String?                       @db.VarChar(50)
  timing_estimado                       String?                       @db.VarChar(100)
  tipo_cliente                          String?                       @db.VarChar(100)
  tipo_contacto                         String?                       @db.VarChar(100)
  tipo_oportunidad                      String?                       @db.VarChar(100)
  cliente_beck_id                       String?                       @db.Uuid
  contacto_beck_id                      String?                       @db.Uuid
  antecedentes_levantados               String?
  anticipo                              String?
  aprobacion_interna_cliente            String?
  asistentes                            String?
  bases_tecnicas                        String?
  comentarios_cliente                   String?
  comentarios_internos                  String?
  condiciones_especiales                String?
  condiciones_pago                      String?
  contrato                              String?
  correo_aceptacion                     String?
  documentos_administrativos_pendientes String?
  documentos_recibidos                  String?
  documentos_requeridos                 String?
  especificaciones                      String?
  estado_desarrollo_propuesta           String?
  fecha_cierre                          DateTime?                     @db.Date
  fecha_comprometida_envio              DateTime?                     @db.Date
  fecha_envio_propuesta                 DateTime?                     @db.Date
  fecha_firma                           DateTime?                     @db.Date
  fecha_inicio_proyecto                 DateTime?                     @db.Date
  fecha_vencimiento_propuesta           DateTime?                     @db.Date
  fecha_visita                          DateTime?                     @db.Date
  fotografias                           String?
  informacion_pendiente                 String?
  lugar_visita                          String?
  monto_final_ganado                    Decimal?                      @db.Decimal(14, 2)
  monto_propuesto                       Decimal?                      @db.Decimal(14, 2)
  necesidad_oficina_tecnica             Boolean?
  necesidad_validacion_gerencial        Boolean?
  numero_propuesta                      String?                       @db.VarChar(100)
  observaciones_tecnicas                String?
  orden_compra                          String?
  planos                                String?
  proximos_pasos                        String?
  responsable_administrativo            String?                       @db.VarChar(255)
  responsable_tecnico                   String?                       @db.VarChar(255)
  riesgo_tecnico                        String?                       @db.VarChar(50)
  version_propuesta                     String?                       @db.VarChar(50)
  obra_id                               String?                       @db.Uuid
  fecha_traspaso_administracion         DateTime?                     @db.Date
  fecha_traspaso_operaciones            DateTime?                     @db.Date
  observaciones_traspaso_administracion String?
  observaciones_traspaso_operaciones    String?
  responsable_traspaso_administracion   String?                       @db.VarChar(255)
  responsable_traspaso_operaciones      String?                       @db.VarChar(255)
  traspasado_administracion             Boolean?
  traspasado_operaciones                Boolean?
  direccion_proyecto                    String?
  observaciones                         String?
  unidad_negocio                        String?                       @db.VarChar(150)
  observacion_campos_faltantes          String?
  urgencia                              String?                       @db.VarChar(50)
  duracion_estimada                     String?                       @db.VarChar(100)
  empresa_mandante                      String?
  estado_documentacion_venta            String?                       @db.VarChar(100)
  estado_revision_tecnica               String?                       @db.VarChar(50)
  garantias_requeridas                  String?
  necesidad_levantamiento               Boolean?
  oficina_tecnica_asignada              String?                       @db.VarChar(255)
